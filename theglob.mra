<misterromdescription>
    <!--
        The ROM recipe.  tools/mra_build.py reads this and your MAME romset and
        writes theglob.rom; any standard MRA tool does the same.

        Image layout (30752 bytes), which target/pocket/theglob_mem.sv and
        sim/tb_mem.cpp assume:
          0x0000-0x77FF  Z80 program, u10 u9 u8 u7 u6 u5 u4 u11 as MAME loads it
          0x7800-0x781F  colour PROM 82s123.u66 (from the parent set suprglob;
                         a split theglob.zip may not carry it; a merged or
                         non-merged set does)
        Checked against MAME's own regions by tools/verify_rom.py.
    -->
    <name>The Glob</name>
    <setname>theglob</setname>
    <rbf>theglob</rbf>
    <mameversion>0288</mameversion>
    <year>1983</year>
    <manufacturer>Epos Corporation</manufacturer>
